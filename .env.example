# Copy this file to .env and fill in ONE provider. Never commit .env.

# "gemini" (free tier at https://aistudio.google.com/apikey) or "openai"
LLM_PROVIDER=gemini

GOOGLE_API_KEY=
OPENAI_API_KEY=

# Optional overrides (change if your provider says a model name is not found)
# GEMINI_CHAT_MODEL=models/gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=models/gemini-3.1-flash-lite
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=4
